   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import xarray as xr\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.dates as mdates\n",
    "import warnings\n",
    "import os\n",
    "\n",
    "# ==========================================\n",
    "# HELPER FUNCTION FOR LAPSE RATE\n",
    "# ==========================================\n",
    "def get_moist_lapse_rate(temp):\n",
    "    if temp > 10:\n",
    "        return 0.005  # 5.0 C/km\n",
    "    elif 0 < temp <= 10:\n",
    "        return 0.006  # 6.0 C/km\n",
    "    else:\n",
    "        return 0.007  # 7.0 C/km\n",
    "\n",
    "# ==========================================\n",
    "# THE PROCESSING FUNCTION (Ze + W Thickness Method)\n",
    "# ==========================================\n",
    "def get_melting_height_filtered(MRR_filtered, altitude, gate_size=100):\n",
    "    warnings.filterwarnings(action='ignore', category=RuntimeWarning)\n",
    "    num_profiles = MRR_filtered['Ze'].shape[0]\n",
    "    \n",
    "    dates_out = []\n",
    "    bot_heights = np.full(num_profiles, np.nan)\n",
    "    thicknesses = np.full(num_profiles, np.nan)\n",
    "    \n",
    "    virga_threshold = 5500\n",
    "    virga_idx_limit = int(np.ceil((virga_threshold - altitude) / gate_size))\n",
    "    virga_idx_limit = max(0, virga_idx_limit) \n",
    "\n",
    "    for j in range(num_profiles):\n",
    "        current_date = MRR_filtered['dates'][j]\n",
    "        dates_out.append(current_date)\n",
    "        \n",
    "        Z_row = MRR_filtered['Ze'][j, :]\n",
    "        W_row = MRR_filtered['W'][j, :]\n",
    "        \n",
    "        if virga_idx_limit > 0:\n",
    "            if np.nansum(Z_row[0:virga_idx_limit]) == 0 or np.all(np.isnan(Z_row[0:virga_idx_limit])):\n",
    "                continue  \n",
    "\n",
    "        diffs_z = np.gradient(Z_row).astype(float)\n",
    "        diffs_w = np.gradient(W_row).astype(float)\n",
    "        \n",
    "        diffs_z[diffs_z >= 0] = np.nan\n",
    "        diffs_w[diffs_w >= 0] = np.nan\n",
    "        \n",
    "        if not (np.all(np.isnan(diffs_z)) or np.all(np.isnan(diffs_w))):\n",
    "            max_z_idx = np.nanargmin(diffs_z)\n",
    "            top_m = (max_z_idx * gate_size) + altitude\n",
    "            \n",
    "            max_w_idx = np.nanargmin(diffs_w)\n",
    "            bot_m = (max_w_idx * gate_size) + altitude\n",
    "            \n",
    "            bot_heights[j] = bot_m\n",
    "            \n",
    "            if max_z_idx >= max_w_idx and (max_z_idx - max_w_idx) <= 10:\n",
    "                thicknesses[j] = top_m - bot_m\n",
    "\n",
    "    final_heights = np.full(num_profiles, np.nan)\n",
    "    block_mean_heights = []\n",
    "    block_mean_dates = []\n",
    "    \n",
    "    start = 0\n",
    "    block_count = 1\n",
    "    \n",
    "    while start < num_profiles:\n",
    "        ending = min(start + 60, num_profiles)\n",
    "        \n",
    "        hourly_avg_thick = np.nanmedian(thicknesses[start:ending])\n",
    "        \n",
    "        for k in range(start, ending):\n",
    "            if pd.notna(bot_heights[k]):\n",
    "                if pd.notna(hourly_avg_thick):\n",
    "                    final_heights[k] = bot_heights[k] + hourly_avg_thick\n",
    "                else:\n",
    "                    final_heights[k] = bot_heights[k] \n",
    "                \n",
    "        for k in range(start, ending):\n",
    "            if final_heights[k] >= 6000:\n",
    "                final_heights[k] = np.nan\n",
    "                \n",
    "        std_height = np.nanstd(final_heights[start:ending])\n",
    "        mn_height = np.nanmean(final_heights[start:ending])\n",
    "        \n",
    "        for k in range(start, ending):\n",
    "            if pd.notna(final_heights[k]):\n",
    "                if pd.notna(std_height) and std_height > 0:\n",
    "                    if (final_heights[k] > mn_height + 1*std_height) or (final_heights[k] < mn_height - 1*std_height):\n",
    "                        final_heights[k] = np.nan\n",
    "                        \n",
    "        final_block_mean = np.nanmean(final_heights[start:ending])\n",
    "        if pd.notna(final_block_mean):\n",
    "            block_mean_heights.append(final_block_mean)\n",
    "            middle_idx = start + ((ending - start) // 2)\n",
    "            block_mean_dates.append(dates_out[middle_idx])\n",
    "            \n",
    "        start = ending\n",
    "        block_count += 1\n",
    "\n",
    "    return {\n",
    "        'dates': pd.to_datetime(dates_out), \n",
    "        'heights_both': final_heights,\n",
    "        'mean_dates': pd.to_datetime(block_mean_dates), \n",
    "        'mean_heights': np.array(block_mean_heights)\n",
    "    }\n",
    "\n",
    "# ==========================================\n",
    "# DATA LOADING (NetCDF + CSVs)\n",
    "# ==========================================\n",
    "target_events = [{\"start\": \"2025-07-22 10:00\", \"end\": \"2025-07-22 17:00\"}\n"],
    "\n",
    "file_path = r'C:\\Working_File\\sample_data.nc' \n",
    "output_folder = r'C:\\Working_File\\Output\\'\n",
    "\n",
    "csv_stn1 = r'C:\\Working_File\\camp_II_T_local_time.csv'\n",
    "csv_stn2 = r'C:\\Working_File\\Base_Camp_T_local_time.csv'\n",
    "csv_stn3 = r'C:\\Working_File\\AWS_Pyramid_filled.csv'\n",
    "\n",
    "TIME_COL_1, TEMP_COL_1 = 'Date', 'T'  \n",
    "TIME_COL_2, TEMP_COL_2 = 'Date', 'T'  \n",
    "TIME_COL_3, TEMP_COL_3, PREC_COL_3 = 'Date', 'T', 'P' \n",
    "\n",
    "NAME_STN1 = \"Camp II\" \n",
    "NAME_STN2 = \"Base Camp\"\n",
    "NAME_STN3 = \"Pyramid\"\n",
    "\n",
    "altitude = 5050  \n",
    "gate_size = 100  \n",
    "\n",
    "if not os.path.exists(output_folder):\n",
    "    os.makedirs(output_folder)\n",
    "\n",
    "print(\"Loading NetCDF file into memory...\")\n",
    "ds = xr.open_dataset(file_path)\n",
    "\n",
    "print(\"Loading Meteorological CSV files into memory...\")\n",
    "df_stn1 = pd.read_csv(csv_stn1)\n",
    "df_stn1[TIME_COL_1] = pd.to_datetime(df_stn1[TIME_COL_1])\n",
    "df_stn1.set_index(TIME_COL_1, inplace=True)\n",
    "\n",
    "df_stn2 = pd.read_csv(csv_stn2)\n",
    "df_stn2[TIME_COL_2] = pd.to_datetime(df_stn2[TIME_COL_2])\n",
    "df_stn2.set_index(TIME_COL_2, inplace=True)\n",
    "\n",
    "df_stn3 = pd.read_csv(csv_stn3)\n",
    "df_stn3[TIME_COL_3] = pd.to_datetime(df_stn3[TIME_COL_3])\n",
    "df_stn3.set_index(TIME_COL_3, inplace=True)\n",
    "\n",
    "# ==========================================\n",
    "# PROCESS EACH EVENT\n",
    "# ==========================================\n",
    "for i, event in enumerate(target_events):\n",
    "    event_num = i + 1\n",
    "    start_time = event['start']\n",
    "    end_time = event['end']\n",
    "    \n",
    "    ax3_twin = None\n",
    "    \n",
    "    print(f\"\\n--- Processing Event {event_num}/{len(target_events)}: {start_time} to {end_time} ---\")\n",
    "    \n",
    "    try:\n",
    "        ds_event = ds.sel(time=slice(start_time, end_time))\n",
    "    except Exception as e:\n",
    "        print(f\"Error slicing NetCDF data. Skipping. Error: {e}\")\n",
    "        continue\n",
    "        \n",
    "    time_data = pd.to_datetime(ds_event['time'].values)\n",
    "    if len(time_data) == 0:\n",
    "        print(\"No radar data found in this specific time range. Skipping.\")\n",
    "        continue\n",
    "\n",
    "    Z_data = ds_event['Ze'].values  \n",
    "    W_data = ds_event['W'].values   \n",
    "\n",
    "    df_event_stn1 = df_stn1.loc[start_time:end_time]\n",
    "    df_event_stn2 = df_stn2.loc[start_time:end_time]\n",
    "    df_event_stn3 = df_stn3.loc[start_time:end_time]\n",
    "\n",
    "    malr_series = df_event_stn3[TEMP_COL_3].apply(get_moist_lapse_rate)\n",
    "    calculated_fl_pyramid = altitude + (df_event_stn3[TEMP_COL_3] / malr_series)\n",
    "\n",
    "    MRR_filtered = {\n",
    "        'dates': time_data,\n",
    "        'Ze': Z_data,\n",
    "        'W': W_data                \n",
    "    }\n",
    "\n",
    "    print(\"Calculating melting layer heights...\")\n",
    "    melting_height = get_melting_height_filtered(MRR_filtered, altitude, gate_size)\n",
    "    print(\"Plotting and saving...\")\n",
    "\n",
    "    # ==========================================\n",
    "    # PLOTTING FOR THIS SPECIFIC EVENT (MANUAL LAYOUT)\n",
    "    # ==========================================\n",
    "    num_gates = Z_data.shape[1]\n",
    "    height_bins = (np.arange(num_gates) * gate_size) + altitude\n",
    "\n",
    "    fig = plt.figure(figsize=(20, 12))\n",
    "\n",
    "    # --- DEFINING EXACT POSITIONS ---\n",
    "    panel_left = 0.06\n",
    "    panel_width = 0.85  \n",
    "    \n",
    "    ax1 = fig.add_axes([panel_left, 0.68, panel_width, 0.25]) # Top\n",
    "    ax2 = fig.add_axes([panel_left, 0.38, panel_width, 0.25], sharex=ax1) # Middle\n",
    "    ax3 = fig.add_axes([panel_left, 0.08, panel_width, 0.25], sharex=ax1) # Bottom\n",
    "    \n",
    "    # Defining EXACT boxes for the colorbars neatly next to ax1 and ax2\n",
    "    cbar_left = panel_left + panel_width + 0.01 \n",
    "    cbar_width = 0.015\n",
    "    cax1 = fig.add_axes([cbar_left, 0.68, cbar_width, 0.25])\n",
    "    cax2 = fig.add_axes([cbar_left, 0.38, cbar_width, 0.25])\n",
    "\n",
    "    # --- PANEL 1: REFLECTIVITY (Ze) ---\n",
    "    pcm1 = ax1.pcolormesh(time_data, height_bins, Z_data.T, cmap='jet', vmin=0, vmax=30, shading='auto')\n",
    "    cbar1 = fig.colorbar(pcm1, cax=cax1)\n",
    "    cbar1.set_label('Reflectivity (dBZ)', rotation=270, labelpad=15)\n",
    "    \n",
    "    ax1.set_title(f'Event {event_num}: {start_time} to {end_time}', fontsize=16, fontweight='bold')\n",
    "    ax1.set_ylabel('Elevation a.s.l (m)', fontsize=12)\n",
    "    ax1.set_ylim([altitude, 8000])  \n",
    "    \n",
    "    ax1.plot(melting_height['dates'], melting_height['heights_both'], \n",
    "            linestyle='none', marker='o', color='black', markerfacecolor='none', \n",
    "            label='1-min Melting Height')\n",
    "\n",
    "    ax1.plot(melting_height['mean_dates'], melting_height['mean_heights'], \n",
    "            linestyle='none', marker='s', color='gold', markersize=10,\n",
    "            markeredgecolor='black', label='60-Min Mean Height')\n",
    "            \n",
    "    ax1.plot(df_event_stn3.index, calculated_fl_pyramid, color='cyan', \n",
    "             linestyle='--', linewidth=2.5, label='Calc. 0°C (Pyramid)')\n",
    "             \n",
    "    # Legend \n",
    "    ax1.legend(loc='upper right', framealpha=0.95, edgecolor='black', fontsize=10)\n",
    "\n",
    "    # --- PANEL 2: VELOCITY (W) ---\n",
    "    pcm2 = ax2.pcolormesh(time_data, height_bins, W_data.T, cmap='coolwarm', vmin=0, vmax=8, shading='auto')\n",
    "    cbar2 = fig.colorbar(pcm2, cax=cax2)\n",
    "    cbar2.set_label('Doppler Velocity (m/s)', rotation=270, labelpad=15)\n",
    "\n",
    "    ax2.plot(melting_height['dates'], melting_height['heights_both'], \n",
    "            linestyle='none', marker='o', color='black', markerfacecolor='none', \n",
    "            label='1-min Melting Height')\n",
    "\n",
    "    ax2.plot(melting_height['mean_dates'], melting_height['mean_heights'], \n",
    "            linestyle='none', marker='s', color='gold', markersize=10,\n",
    "            markeredgecolor='black', label='60-Min Mean Height')\n",
    "\n",
    "    ax2.plot(df_event_stn3.index, calculated_fl_pyramid, color='cyan', \n",
    "             linestyle='--', linewidth=2.5, label='Calc. 0°C (Pyramid)')\n",
    "\n",
    "    ax2.set_ylabel('Elevation a.s.l (m)', fontsize=12)\n",
    "    ax2.set_ylim([altitude, 8000])  \n",
    "    \n",
    "    ax2.legend(loc='upper right', framealpha=0.95, edgecolor='black', fontsize=10)\n",
    "\n",
    "    # --- PANEL 3: TEMPERATURES & PRECIPITATION ---\n",
    "    if not df_event_stn1.empty:\n",
    "        ax3.plot(df_event_stn1.index, df_event_stn1[TEMP_COL_1], color='tab:orange', linewidth=2.5, label=NAME_STN1)\n",
    "    if not df_event_stn2.empty:\n",
    "        ax3.plot(df_event_stn2.index, df_event_stn2[TEMP_COL_2], color='tab:green', linewidth=2.5, label=NAME_STN2)\n",
    "    if not df_event_stn3.empty:\n",
    "        ax3.plot(df_event_stn3.index, df_event_stn3[TEMP_COL_3], color='tab:purple', linewidth=2.5, label=NAME_STN3)\n",
    "\n",
    "    if not df_event_stn3.empty and PREC_COL_3 in df_event_stn3.columns:\n",
    "        ax3_twin = ax3.twinx()\n",
    "        ax3_twin.bar(df_event_stn3.index, df_event_stn3[PREC_COL_3], color='tab:blue', alpha=0.5, width=0.01, label='Precipitation')\n",
    "        ax3_twin.set_ylabel('Precipitation (mm)', fontsize=12)\n",
    "\n",
    "    if df_event_stn1.empty and df_event_stn2.empty and df_event_stn3.empty:\n",
    "        ax3.text(0.5, 0.5, 'No Temp Data Available for this Event', horizontalalignment='center', verticalalignment='center', transform=ax3.transAxes)\n",
    "\n",
    "    ax3.axhline(0, color='red', linestyle='--', linewidth=2.5, label='0°C Isotherm')\n",
    "    ax3.set_ylabel('Temperature (°C)', fontsize=12)\n",
    "    ax3.set_xlabel('Time (Local Time)', fontsize=12)\n",
    "    ax3.set_ylim([-10, 10]) \n",
    "    \n",
    "    # Grid \n",
    "    ax3.grid(True, linestyle=':', alpha=0.7)\n",
    "\n",
    "    # --- COMBINE PANEL 3 LEGENDS ---\n",
    "    lines_ax3, labels_ax3 = ax3.get_legend_handles_labels()\n",
    "    if ax3_twin is not None:\n",
    "        lines_twin, labels_twin = ax3_twin.get_legend_handles_labels()\n",
    "        ax3.legend(lines_ax3 + lines_twin, labels_ax3 + labels_twin, loc='upper right', framealpha=0.95, edgecolor='black', fontsize=10)\n",
    "    else:\n",
    "        ax3.legend(loc='upper right', framealpha=0.95, edgecolor='black', fontsize=10)\n",
    "\n",
    "    # --- FORCE BOUNDARIES ---\n",
    "    exact_start = pd.to_datetime(start_time)\n",
    "    exact_end = pd.to_datetime(end_time)\n",
    "    ax1.set_xlim([exact_start, exact_end])\n",
    "    \n",
    "    ax1.margins(x=0)\n",
    "    ax2.margins(x=0)\n",
    "    ax3.margins(x=0)\n",
    "    \n",
    "    ax3.xaxis.set_major_formatter(mdates.DateFormatter('%m-%d %H:%M'))\n",
    "    fig.autofmt_xdate() \n",
    "    \n",
    "    safe_start_time = pd.to_datetime(start_time).strftime('%Y%m%d_%H%M')\n",
    "    safe_end_time = pd.to_datetime(end_time).strftime('%Y%m%d_%H%M')\n",
    "    \n",
    "    save_path = os.path.join(output_folder, f\"FilteredMethod_Event_{safe_start_time}_{safe_end_time}.png\")\n",
    "    \n",
    "    plt.savefig(save_path, dpi=300) \n",
    "    plt.close(fig)\n",
    "    print(f\"Saved: {save_path}\")\n",
    "\n",
    "ds.close()\n",
    "print(\"\\nAll target events processed successfully!\")"
   ]
  }
